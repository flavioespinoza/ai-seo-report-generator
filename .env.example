# NextAuth.js Configuration
# For Google OAuth, get your client ID and secret from: https://console.cloud.google.com/apis/credentials
# A secret can be generated with the command: openssl rand -base64 32
# The NEXTAUTH_URL should be the base URL of your application.
GOOGLE_CLIENT_ID=<your_google_client_id>
GOOGLE_CLIENT_SECRET=<your_google_client_secret>
NEXTAUTH_SECRET=<your_nextauth_secret>
NEXTAUTH_URL=http://localhost:3000

# OpenAI API Key
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=<your_openai_api_key>

# MongoDB Configuration
# Set up your database at: https://www.mongodb.com/cloud/atlas/register
# MongoDB connection string
MONGODB_URI=mongodb+srv://<your_database_username>:<your_database_password>@cluster.mongodb.net/<your_database_name>?retryWrites=true&w=majority
# MongoDB database name
MONGODB_DB=<your_database_name>
